# All secrets are server-only. Copy to .env.local; never use NEXT_PUBLIC_ for these.
LOGTO_ENDPOINT=
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_BASE_URL=http://localhost:3000
LOGTO_COOKIE_SECRET=
GUEST_COOKIE_SECRET=
DATABASE_URL=postgresql://resume_builder_app:password@host:5432/resume_builder
# DDL credentials belong in a separate ignored .env.database-admin.local file,
# not in the application runtime environment:
# DATABASE_ADMIN_URL=postgresql://maintenance_user:password@host:5432/resume_builder
# DATABASE_ADMIN_ROLE=resume_builder_owner
# disable | require (validates the server certificate)
DATABASE_SSL=disable
# Only set behind a proxy that overwrites this header and prevents direct access.
# Vercel's x-vercel-forwarded-for is selected automatically on Vercel.
TRUSTED_IP_HEADER=
GUEST_IP_DAILY_LIMIT=10
GUEST_IP_DAILY_IDENTITIES=5
